<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LiftKit does not track users or collect data off-device. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason API usage (anti-fingerprinting transparency; this is
	     SEPARATE from data collection above and does not affect the "Data Not
	     Collected" label). UserDefaults is used for:
	       • CA92.1 — this app's own settings (@AppStorage / UserDefaults.standard).
	       • 1C8F.1 — shared App Group defaults (SuiteProfileStore, via
	         UserDefaults(suiteName: group.com.ferrixguild.suite)); read/written
	         on-device between the developer's own suite apps and never sent off
	         device. On-device sharing is not "collection." -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
